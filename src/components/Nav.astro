---
import Icon from "./Icon.astro";
import { site, images, ext } from "../data/site";
---
<nav class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 text-paper" aria-label="Main">
  <a href="/" aria-label={site.name} class="block justify-self-start">
    {images.logo ? (
      <img src={images.logo} alt={site.name} height="42" class="block h-[2.625rem] w-auto" />
    ) : (
      <span role="img" aria-label={site.name} class="block size-[2.625rem] rounded-[0.625rem] bg-white/[0.08]"></span>
    )}
  </a>
  <ul class="hidden items-center gap-10 text-lg md:flex xl:gap-14 xl:text-xl">
    {site.nav.map((l) => <li><a href={l.href} class="transition-colors hover:text-accent" {...ext(l.href)}>{l.label}</a></li>)}
  </ul>
  <div class="flex items-center gap-2 justify-self-end">
    <a href="/download" class="btn bg-accent text-ink"><Icon name="download" class="size-5" />Download</a>
    <details class="relative md:hidden">
      <summary class="grid size-12 cursor-pointer list-none place-items-center rounded-full bg-white/10" aria-label="Menu"><Icon name="menu" /></summary>
      <ul class="absolute right-0 top-14 z-20 w-48 rounded-2xl bg-ink/95 p-2 text-lg backdrop-blur">
        {site.nav.map((l) => <li><a href={l.href} class="block rounded-xl px-4 py-3 hover:bg-white/10" {...ext(l.href)}>{l.label}</a></li>)}
      </ul>
    </details>
  </div>
</nav>
