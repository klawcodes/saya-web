---
// Semua ikon situs berasal dari library lewat astro-icon (diinline saat build, tanpa JS tambahan):
//   - Lucide (lucide:*)         -> ikon antarmuka
//   - Simple Icons (simple-icons:*) -> logo merek (Windows 11, Linux)
// Nama pendek di bawah dipertahankan supaya pemanggil lama (<Icon name="download" />, data fitur di
// data/site) tidak perlu diubah. Nama lengkap seperti "lucide:rocket" juga bisa dipakai langsung.
import { Icon as AstroIcon } from "astro-icon/components";

const alias: Record<string, string> = {
  download: "lucide:download",
  menu: "lucide:menu",
  shield: "lucide:shield",
  globe: "lucide:globe",
  moon: "lucide:moon",
  keyboard: "lucide:keyboard",
  sliders: "lucide:sliders-horizontal",
  file: "lucide:file",
  external: "lucide:external-link",
  chevron: "lucide:chevron-down",
  windows: "simple-icons:windows11",
  linux: "simple-icons:linux",
};

const { name, class: cls = "size-6" } = Astro.props;
const id = name.includes(":") ? name : alias[name];
// Garis ikon Lucide sedikit ditipiskan (bawaan 2) supaya mirip gaya sebelumnya
const thin = id?.startsWith("lucide:") ? "[&_*]:stroke-[1.6]" : "";
---
<AstroIcon name={id} class={[cls, thin].filter(Boolean).join(" ")} aria-hidden="true" />
