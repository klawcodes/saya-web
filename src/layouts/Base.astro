---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site, images } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  hero?: boolean;
  jsonLd?: object | object[];
  noindex?: boolean;
}
const { title, description = site.description, hero = false, jsonLd, noindex = false } = Astro.props;

const full = title ? `${title} | ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const origin = new URL("/", Astro.site).href;
const og = images.og ? new URL(images.og, Astro.site).href : null;

const schemas: object[] = [
  {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${origin}#website`,
  name: site.name,
  alternateName: ["Saya", "Saya Browser", "Saya Web Browser"],
  url: origin,
  inLanguage: "en",
},
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.owner,
    url: origin,
    logo: new URL(images.logo, Astro.site).href,
    sameAs: [site.repo],
  },
];
if (Astro.url.pathname === "/") {
  schemas.push({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${origin}#app`,
  name: site.name,
  alternateName: ["Saya", "Saya Web Browser"],
  description: site.description,
  applicationCategory: "BrowserApplication",
  operatingSystem: "Windows 10, Windows 11",
  softwareVersion: site.version,
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  downloadUrl: site.releaseUrl,
  installUrl: site.releaseUrl,
  codeRepository: site.repo,
  screenshot: images.og ? new URL(images.og, Astro.site).href : undefined,
  image: og ?? undefined,
  url: origin,
  author: { "@type": "Person", name: site.owner },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
});
}
if (jsonLd) schemas.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="author" content={site.owner} />
    <meta name="theme-color" content="#030303" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && (
      <>
        <meta property="og:image" content={og} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={images.ogAlt} />
      </>
    )}

    <meta name="twitter:card" content={og ? "summary_large_image" : "summary"} />
    <meta name="twitter:site" content={site.twitter} />
    <meta name="twitter:creator" content={site.twitter} />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    {og && <meta name="twitter:image" content={og} />}
    {og && <meta name="twitter:image:alt" content={images.ogAlt} />}

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="bg-ink font-sans text-paper antialiased">
    {!hero && (
      <div class="sticky -top-5 z-50 mx-auto max-w-6xl px-6 pt-8 md:-top-8">
        <Nav />
      </div>
    )}
    <main><slot /></main>
    <Footer />
  </body>
</html>