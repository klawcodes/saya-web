---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Media from "../components/Media.astro";
import Icon from "../components/Icon.astro";
import { site, images, features, ext } from "../data/site";

const shots = [
  { src: images.shotA, alt: "Saya downloads panel", caption: "The downloads panel opens by itself and closes when it's done." },
  { src: images.shotB, alt: "Saya site info menu", caption: "Site info and permissions, one click from the address bar." },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  description: site.description,
  applicationCategory: "BrowserApplication",
  operatingSystem: "Windows 10, Windows 11",
  softwareVersion: site.version,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Organization", name: site.owner },
};
---
<Base hero jsonLd={jsonLd}>
  <section class="mx-3 mt-3 overflow-hidden rounded-[2rem] bg-[#0c0c0c] sm:mx-[1.875rem] sm:mt-[1.875rem] md:rounded-[3.75rem]" aria-labelledby="hero-title">
    <div class="relative isolate">
      <div class="absolute inset-0 -z-10">
        <Media src={images.heroBackground} width={1860} height={1100} eager />
        <div class="absolute inset-0 bg-black/25"></div>
      </div>
      <div class="px-5 pt-6 sm:px-8 sm:pt-8 md:px-8 md:pt-10"><Nav /></div>
      <div class="px-6 pt-[clamp(5rem,13vw,13rem)] text-center">
        <h1 id="hero-title" class="mx-auto text-[clamp(2.75rem,7vw,6rem)] leading-[0.95] tracking-[-0.06em]">It's just a browser,<br />no gimmick.</h1>
        <p class="mx-auto mt-8 max-w-xl text-lg md:text-xl">Private by default, fast to use, and built to stay out of your way.</p>
        <a href={site.releaseUrl} class="btn mt-10 bg-accent text-ink" {...ext(site.releaseUrl)}><Icon name="download" class="size-5" />Download for Windows</a>
      </div>
      <div class="mx-auto mt-[clamp(3rem,6vw,6rem)] aspect-[1116/540] w-[min(69.75rem,92%)] overflow-hidden rounded-t-xl">
        <div class="aspect-[1320/700]"><Media src={images.heroScreenshot} alt="Saya browsing Wikipedia" width={1320} height={700} eager /></div>
      </div>
      <!-- Gradasi hitam ke transparan (ke arah atas), selebar hero, di tepi bawah; menimpa screenshot -->
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[clamp(6rem,15vw,13rem)] bg-gradient-to-t from-ink to-transparent" aria-hidden="true"></div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pt-28 md:pt-40" id="features">
    <h2 class="max-w-2xl text-3xl leading-tight md:text-5xl">What's inside Saya</h2>
    <ul class="mt-12 divide-y divide-white/10 border-y border-white/10">
      {features.map((f) => (
        <li class="grid gap-3 py-8 md:grid-cols-[19rem_1fr] md:gap-10">
          <div class="flex items-center gap-3 text-xl"><Icon name={f.icon} class="size-6 shrink-0 text-accent" />{f.title}</div>
          <p class="max-w-xl text-lg text-paper/70">{f.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-6 pt-28 md:pt-40">
    <h2 class="max-w-2xl text-3xl leading-tight md:text-5xl">Quiet by design</h2>
    <p class="mt-4 max-w-xl text-lg text-paper/70">Spacing follows the Fibonacci sequence and proportions follow the golden ratio, so the interface stays calm and out of the way.</p>
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {shots.map((s) => (
        <figure>
          <div class="aspect-[1116/700] overflow-hidden rounded-2xl"><Media src={s.src} alt={s.alt} width={1116} height={700} /></div>
          <figcaption class="mt-3 text-paper/60">{s.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pt-28 md:pt-40">
    <div class="flex flex-col items-start justify-between gap-8 rounded-[2rem] bg-accent p-8 text-ink md:flex-row md:items-center md:rounded-[3rem] md:p-14">
      <div>
        <h2 class="text-3xl md:text-5xl">Try Saya</h2>
        <p class="mt-3 max-w-md text-lg text-ink/80">Version {site.version} for Windows 10 and 11. Linux is on the way.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={site.releaseUrl} class="btn bg-ink text-paper" {...ext(site.releaseUrl)}><Icon name="download" class="size-5" />Download for Windows</a>
        <a href="/download" class="btn bg-paper text-ink">All downloads</a>
      </div>
    </div>
  </section>
</Base>
