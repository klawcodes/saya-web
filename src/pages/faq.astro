---
import Base from "../layouts/Base.astro";
import { faqs } from "../data/site";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<Base title="FAQ" description="Answers to common questions about Saya." jsonLd={jsonLd}>
  <section class="mx-auto max-w-4xl px-6 pt-20">
    <h1 class="text-4xl md:text-6xl">FAQ</h1>
    <ul class="mt-12 divide-y divide-white/10 border-y border-white/10">
      {faqs.map((f) => (
        <li>
          <details class="group py-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-xl">{f.q}<span class="text-2xl text-accent transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
            <p class="mt-4 max-w-2xl text-lg text-paper/70">{f.a}</p>
          </details>
        </li>
      ))}
    </ul>
  </section>
</Base>
